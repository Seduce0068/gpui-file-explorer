#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# DEBIAN/postinst: the shipped .desktop file declares MimeType=inode/directory;
# refresh the desktop database so launchers and file managers register it.
# update-desktop-database lives in desktop-file-utils, which may be absent, so
# the call is guarded and never fails the package installation.
set -e
if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
exit 0
